# Processing Engine — Environment Variables
# Copy to .env and fill in values

# REQUIRED — API authentication (no default, app won't start without it)
PE_API_KEY=your-secret-api-key

# Server
PE_HOST=0.0.0.0
PE_PORT=8000

# Database — Processing Engine internal schema
PE_DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/processing_engine

# Database — VotoLimpo target (where sink writes)
PE_VOTOLIMPO_DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/votolimpo

# OpenAI API key for LLM processing
PE_OPENAI_API_KEY=sk-...

# Engine role: "api" (serve HTTP only), "worker" (process jobs only), "both" (default)
PE_ENGINE_ROLE=both

# Worker settings
PE_WORKER_CONCURRENCY=3
PE_WORKER_POLL_INTERVAL=2.0

# Directories (relative to project root or absolute paths)
PE_PIPELINES_DIR=./pipelines
PE_PROMPTS_DIR=./prompts
PE_SCHEMAS_DIR=./schemas

# Logging
PE_LOG_LEVEL=INFO
