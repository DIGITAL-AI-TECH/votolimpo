{
  "$comment": "Reference copy of the output_schema defined inline in pipelines/voto-limpo-news-analysis.yaml. NOT loaded at runtime — the YAML inline schema is the source of truth. Keep in sync manually.",
  "type": "object",
  "required": [
    "politicians",
    "severity",
    "summary",
    "keywords",
    "veracity_signals",
    "is_political",
    "entity_names"
  ],
  "additionalProperties": false,
  "properties": {
    "politicians": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "party", "state", "role", "article_role", "relevance_score"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "description": "Politician name as it appears in text" },
          "party": { "type": ["string", "null"], "description": "Party if explicitly mentioned" },
          "state": { "type": ["string", "null"], "description": "State (UF) if explicitly mentioned" },
          "role": { "type": ["string", "null"], "description": "Political office if explicitly mentioned" },
          "article_role": {
            "type": "string",
            "enum": ["protagonist", "mentioned", "investigated", "witness", "victim", "other"],
            "description": "Role in the article context"
          },
          "relevance_score": { "type": "number", "description": "0.0-1.0 relevance to the article" }
        }
      },
      "description": "Politicians mentioned in the article"
    },
    "severity": {
      "type": "string",
      "enum": ["low", "medium", "high", "critical"],
      "description": "Severity level based on factual content, not headline"
    },
    "summary": {
      "type": "string",
      "description": "Factual summary of the article (max 500 chars)"
    },
    "keywords": {
      "type": "array",
      "items": { "type": "string" },
      "description": "3-8 event-specific keywords"
    },
    "veracity_signals": {
      "type": "object",
      "required": [
        "source_reputation",
        "multi_source",
        "narrative_consistency",
        "documental_evidence",
        "temporality",
        "emotional_language"
      ],
      "additionalProperties": false,
      "properties": {
        "source_reputation": { "type": "number", "description": "Source reputation 0.0-1.0" },
        "multi_source": { "type": "number", "description": "Multi-source corroboration 0.0-1.0" },
        "narrative_consistency": { "type": "number", "description": "Internal consistency 0.0-1.0" },
        "documental_evidence": { "type": "number", "description": "Documentary evidence 0.0-1.0" },
        "temporality": { "type": "number", "description": "Temporal precision 0.0-1.0" },
        "emotional_language": { "type": "number", "description": "1.0=neutral, 0.0=emotional" }
      },
      "description": "Veracity signals for fact-checking scoring"
    },
    "is_political": {
      "type": "boolean",
      "description": "Whether the article is political in nature"
    },
    "entity_names": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Names of non-person entities (organizations, courts, parties) mentioned"
    }
  }
}
